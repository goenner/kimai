{% extends 'base.html.twig' %}

{% block page_title %}Tagesbuchung — {{ viewed_user.displayName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Worktime/_wt_styles.html.twig' %}
{% endblock %}

{% block page_content_start %}{% include '@Worktime/_flash.html.twig' %}{% endblock %}

{% macro hm(seconds) %}{% apply spaceless %}
    {% set s = seconds < 0 ? -seconds : seconds %}
    {{ seconds < 0 ? '−' : '' }}{{ (s // 3600) }}:{{ '%02d'|format((s % 3600) // 60) }}
{% endapply %}{% endmacro %}

{% block main %}
    {% import _self as fmt %}
    {% set other = app.user is not null and viewed_user.id != app.user.id %}
    {% set review_count = blocks|filter(b => b.needsReview)|length %}
    <div class="wt wt--narrow" data-day="{{ date|date('Y-m-d', false) }}">

        <div class="wt-eyebrow">
            <a class="wt-back" href="{{ back_url }}"><i class="fas fa-chevron-left me-1" aria-hidden="true"></i> Monatskalender</a>
            <strong>{{ date|day_name }}, {{ date|date_short }}</strong>
        </div>

        {% if other %}
            <div class="wt-note wt-note--who" role="note">
                <i class="fas fa-user-pen mt-1" aria-hidden="true"></i>
                <div>
                    <span class="wt-muted">Du siehst und bearbeitest die Zeiten von</span>
                    <strong>{{ viewed_user.displayName }}</strong>
                    {% if can_edit %}<span class="wt-muted">Neue Einträge werden für diese Person gebucht.</span>{% endif %}
                </div>
            </div>
        {% endif %}

        <div class="wt-kpis">
            <div class="wt-kpi">
                <div class="wt-kpi__label">Soll</div>
                <div class="wt-kpi__value">{{ fmt.hm(summary.targetSeconds) }}</div>
            </div>
            <div class="wt-kpi wt-kpi--accent">
                <div class="wt-kpi__label">Ist</div>
                <div class="wt-kpi__value">{{ fmt.hm(day_worked) }}</div>
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Saldo</div>
                <div class="wt-kpi__value {{ summary.balanceSeconds < 0 ? 'wt-neg' : (summary.balanceSeconds > 0 ? 'wt-pos' : '') }}">{{ fmt.hm(summary.balanceSeconds) }}</div>
            </div>
        </div>

        {% if review_count > 0 %}
            <div class="wt-note" role="status">
                <i class="fas fa-triangle-exclamation mt-1" aria-hidden="true"></i>
                <div><strong>Automatisch geschlossen – bitte Endzeit prüfen.</strong>
                    Der markierte Eintrag wurde vom System beendet, weil nicht ausgestempelt wurde.</div>
            </div>
        {% endif %}

        <div class="wt-sessions">
            <div class="wt-sessions__head">
                <h2 class="wt-sessions__title m-0">Buchungen</h2>
                {% if can_edit %}
                    <button type="button" class="wt-add"
                            data-bs-toggle="modal" data-bs-target="#wtEntryModal"
                            data-mode="create" data-action="{{ path('worktime_day_entry_create') }}">
                        <i class="{{ 'create'|icon }}" aria-hidden="true"></i> Zeit eintragen
                    </button>
                {% endif %}
            </div>
            {% for block in blocks %}
                <div class="wt-row {{ block.end is null ? 'wt-row--live' : (block.needsReview ? 'wt-row--review' : '') }}">
                    <span class="wt-row__bullet" aria-hidden="true"></span>
                    <span class="wt-row__time">
                        {{ block.start|time }}<span class="wt-arrow" aria-label="bis">→</span>{% if block.end is null %}<span class="wt-running">läuft</span>{% else %}{{ block.end|time }}{% endif %}
                        {% if block.needsReview %}<span class="wt-flag" title="Automatisch geschlossen – bitte Endzeit prüfen">bitte prüfen</span>{% endif %}
                    </span>
                    <span class="wt-row__dur">{{ block.durationSeconds is null ? 'läuft' : block.durationSeconds|duration }}</span>
                    {% if can_edit %}
                        <button type="button" class="wt-edit" aria-label="Eintrag {{ block.start|time }} bearbeiten" title="Bearbeiten"
                                data-bs-toggle="modal" data-bs-target="#wtEntryModal"
                                data-mode="edit"
                                data-action="{{ path('worktime_day_entry_edit', {id: block.id}) }}"
                                data-delete="{{ path('worktime_day_entry_delete', {id: block.id}) }}"
                                data-start="{{ block.start|date('Y-m-d\\TH:i', viewed_user.timezone) }}"
                                data-end="{{ block.end is null ? '' : block.end|date('Y-m-d\\TH:i', viewed_user.timezone) }}">
                            <i class="{{ 'edit'|icon }}" aria-hidden="true"></i>
                        </button>
                    {% else %}
                        <span></span>
                    {% endif %}
                </div>
            {% else %}
                <div class="wt-empty">Keine Buchung an diesem Tag.</div>
            {% endfor %}
        </div>

        {% if can_edit %}
            {% include '@Worktime/_entry_modal.html.twig' with {token_id: 'worktime.day_entry', user_id: viewed_user.id, default_date: date|date('Y-m-d', false), who: other ? viewed_user.displayName : null} %}
        {% endif %}
    </div>
{% endblock %}
