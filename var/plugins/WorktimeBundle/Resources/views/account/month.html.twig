{% extends 'base.html.twig' %}

{% block page_title %}Zeitkonto — {{ viewed_user.displayName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Worktime/_wt_styles.html.twig' %}
{% endblock %}

{% block page_content_start %}{% include '@Worktime/_flash.html.twig' %}{% endblock %}

{% macro hm(seconds) %}{% apply spaceless %}
    {% set s = seconds < 0 ? -seconds : seconds %}
    {{ seconds < 0 ? '−' : (seconds > 0 ? '+' : '') }}{{ (s // 3600) }}:{{ '%02d'|format((s % 3600) // 60) }}
{% endapply %}{% endmacro %}
{% macro sign(n) %}{{ n < 0 ? 'wt-neg' : (n > 0 ? 'wt-pos' : '') }}{% endmacro %}
{% macro dur(seconds) %}{% apply spaceless %}{{ (seconds // 3600) }}:{{ '%02d'|format((seconds % 3600) // 60) }}{% endapply %}{% endmacro %}

{% block main %}
    {% import _self as fmt %}
    {% set months_de = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'] %}
    {% set wd_de = ['Mo','Di','Mi','Do','Fr','Sa','So'] %}
    {% set today = 'now'|date('Y-m-d') %}
    {% set credit = data.days|reduce((c, d) => c + d.creditSeconds, 0) %}

    <div class="wt">
        {% if warn_overtime %}
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="fas fa-triangle-exclamation me-2 fa-lg" aria-hidden="true"></i>
                <div><strong>Hoher Überstunden-Saldo:</strong> {{ fmt.hm(data.cumulativeSeconds) }} h (ab 6:00 h). Bitte Freizeitausgleich einplanen.</div>
            </div>
        {% endif %}
        {% if not data.has_contract %}
            <div class="alert alert-warning">Für {{ viewed_user.displayName }} ist kein Vertrag hinterlegt – ohne Vertrag lässt sich kein Soll berechnen.</div>
        {% endif %}

        <div class="wt-bar">
            <div>
                <h2 class="wt-bar__title">{{ months_de[month - 1] }} {{ year }}</h2>
                <div class="wt-bar__sub">{{ viewed_user.displayName }}</div>
            </div>
            <nav class="wt-nav" aria-label="Monat wechseln">
                <a class="wt-nav__btn" href="{{ path('worktime_account', {year: prev|date('Y', false), month: prev|date('n', false), user: viewed_user.id}) }}" aria-label="Vormonat: {{ months_de[(prev|date('n', false)) - 1] }}"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                <a class="btn btn-ghost-secondary" href="{{ path('worktime_account', {user: viewed_user.id}) }}">Heute</a>
                <a class="wt-nav__btn" href="{{ path('worktime_account', {year: next|date('Y', false), month: next|date('n', false), user: viewed_user.id}) }}" aria-label="Folgemonat: {{ months_de[(next|date('n', false)) - 1] }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                <a class="btn btn-ghost-secondary" href="{{ path('worktime_account_year', {year: year, user: viewed_user.id}) }}">Jahr</a>
            </nav>
        </div>

        <div class="wt-kpis wt-kpis--4">
            <div class="wt-kpi wt-kpi--lead">
                <div class="wt-kpi__label">Saldo gesamt</div>
                <div class="wt-kpi__value {{ warn_overtime ? 'wt-neg' : fmt.sign(data.cumulativeSeconds) }}">{{ fmt.hm(data.cumulativeSeconds) }}<small>h</small></div>
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Saldo Monat</div>
                <div class="wt-kpi__value {{ fmt.sign(data.balanceSeconds) }}">{{ fmt.hm(data.balanceSeconds) }}<small>h</small></div>
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Ist Monat</div>
                <div class="wt-kpi__value">{{ fmt.dur(data.workedSeconds) }}<small>h</small></div>
                {% if credit > 0 %}<div class="wt-muted small">+ {{ fmt.dur(credit) }} h Urlaubsgutschrift</div>{% endif %}
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Soll Monat</div>
                <div class="wt-kpi__value">{{ fmt.dur(data.targetSeconds) }}<small>h</small></div>
            </div>
        </div>

        {# Desktop: Kalenderraster #}
        <div class="card wt-only-desktop">
            <div class="card-body p-2">
                <table class="wt-cal">
                    <caption class="visually-hidden">Tageskonten {{ months_de[month - 1] }} {{ year }}</caption>
                    <thead><tr>{% for wd in wd_de %}<th scope="col">{{ wd }}</th>{% endfor %}</tr></thead>
                    <tbody>
                    {% for week in calendar_weeks %}
                        <tr>
                        {% for d in week %}
                            {% if d is null %}
                                <td class="wt-cal--empty"></td>
                            {% else %}
                                {% set ymd = d.date|date('Y-m-d', false) %}
                                {% set future = ymd > today %}
                                <td class="{{ d.targetSeconds == 0 ? 'wt-cal--off' }} {{ ymd == today ? 'wt-cal--today' }} {{ future ? 'wt-cal--planned' }}"
                                    {% if ymd == today %}aria-current="date"{% endif %}>
                                    <a class="wt-cal__link" href="{{ path('worktime_account_day', {date: ymd, user: viewed_user.id}) }}"
                                       aria-label="{{ wd_de[(d.date|date('N', false)) - 1] }} {{ d.date|date('j', false) }}.: Tagesbuchung öffnen">
                                        <div class="wt-cal__day">
                                            <span>{{ d.date|date('j', false) }}</span>
                                            {% if review_days[ymd] is defined %}<span class="wt-cal__rev" title="Automatisch geschlossen – bitte Endzeit prüfen"></span>{% endif %}
                                        </div>
                                        {% if d.note %}<span class="wt-cal__badge" title="{{ d.note }}">{{ d.note }}</span>{% endif %}
                                        {% if future %}
                                            {% if d.targetSeconds > 0 and d.creditSeconds == 0 %}<div class="wt-cal__soll mt-1">geplant {{ fmt.dur(d.targetSeconds) }}</div>{% endif %}
                                        {% elseif d.targetSeconds > 0 or d.workedSeconds > 0 %}
                                            <div class="wt-cal__ist">{{ fmt.dur(d.workedSeconds) }} <span class="wt-cal__soll">/ {{ fmt.dur(d.targetSeconds) }}</span></div>
                                            {% if d.balanceSeconds != 0 %}<div class="wt-cal__saldo {{ fmt.sign(d.balanceSeconds) }}">{{ fmt.hm(d.balanceSeconds) }}</div>{% endif %}
                                        {% endif %}
                                    </a>
                                </td>
                            {% endif %}
                        {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Handy: Agenda, ein Tag je Zeile #}
        <div class="card wt-only-mobile">
            <ol class="wt-agenda" aria-label="Tage im {{ months_de[month - 1] }}">
                {% for d in data.days %}
                    {% set ymd = d.date|date('Y-m-d', false) %}
                    {% set future = ymd > today %}
                    {% set off = d.targetSeconds == 0 and d.workedSeconds == 0 %}
                    <li>
                        <a class="wt-agenda__row {{ off ? 'wt-agenda__row--off' }} {{ ymd == today ? 'wt-agenda__row--today' }}"
                           href="{{ path('worktime_account_day', {date: ymd, user: viewed_user.id}) }}" {% if ymd == today %}aria-current="date"{% endif %}>
                            <span class="wt-agenda__date"><b>{{ d.date|date('j', false) }}</b><span>{{ wd_de[(d.date|date('N', false)) - 1] }}</span></span>
                            <span class="wt-agenda__mid">
                                {% if off %}
                                    <span class="wt-muted">frei</span>
                                {% elseif future %}
                                    <span class="wt-muted">geplant {{ fmt.dur(d.targetSeconds) }}</span>
                                {% else %}
                                    <span class="wt-num">{{ fmt.dur(d.workedSeconds) }}</span> <span class="wt-muted">/ {{ fmt.dur(d.targetSeconds) }}</span>
                                {% endif %}
                                {% if d.note %}<span class="wt-cal__badge" title="{{ d.note }}">{{ d.note }}</span>{% endif %}
                                {% if review_days[ymd] is defined %}<span class="wt-flag">bitte prüfen</span>{% endif %}
                            </span>
                            <span class="wt-agenda__saldo {{ fmt.sign(d.balanceSeconds) }}">{% if not future and not off %}{{ fmt.hm(d.balanceSeconds) }}{% endif %}</span>
                        </a>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>
{% endblock %}
