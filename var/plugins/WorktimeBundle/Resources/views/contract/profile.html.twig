{% extends 'user/form.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Worktime/_wt_styles.html.twig' %}
    <style>
        .wt-contract h4 { font-family: var(--wt-display); font-weight: 700; color: var(--wt-heading); font-size: 1.05rem; }
        .wt-contract h4 + * { margin-top: .25rem; }
        .wt-contract .wt-contract__section + .wt-contract__section { border-top: 1px solid var(--wt-hair); padding-top: 1.1rem; margin-top: .4rem; }
    </style>
{% endblock %}

{% block page_content_start %}{% include '@Worktime/_flash.html.twig' %}{% endblock %}

{% block form_content %}
    <div class="wt wt-contract">
        <div class="wt-contract__section">
            <h4 class="mb-2">{{ 'Wöchentliche Sollzeit'|trans }}</h4>
            <div class="row g-2 mb-1">
                {% for day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
                    <div class="col-6 col-sm-3 col-lg">{{ form_row(form['workHours' ~ day]) }}</div>
                {% endfor %}
            </div>
            <p class="wt-muted small mb-3">{{ 'Stunden mit Nachkommastellen, z. B. 7,5. Tage mit 0 gelten als arbeitsfrei und kosten keinen Urlaub.'|trans }}</p>
        </div>

        <div class="wt-contract__section">
            <h4 class="mb-2">{{ 'Urlaub & Feiertage'|trans }}</h4>
            <div class="row g-2 mb-3">
                <div class="col-md-4">{{ form_row(form.holidaysPerYear) }}</div>
                <div class="col-md-4">{{ form_row(form.vacationCarryover) }}</div>
                <div class="col-md-4">{{ form_row(form.holidayRegion) }}</div>
            </div>
        </div>

        <div class="wt-contract__section">
            <h4 class="mb-2">{{ 'Beschäftigung & Zeitkonto'|trans }}</h4>
            <div class="row g-2">
                <div class="col-md-4">{{ form_row(form.employmentStart) }}</div>
                <div class="col-md-4">{{ form_row(form.employmentEnd) }}</div>
                <div class="col-md-4">{{ form_row(form.accountStart) }}</div>
                <div class="col-md-6">{{ form_row(form.initialOvertimeHours) }}</div>
                <div class="col-md-6">{{ form_row(form.dailyEndTime) }}</div>
            </div>
        </div>
        {{ form_rest(form) }}
    </div>
{% endblock %}
