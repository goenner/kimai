{% extends 'base.html.twig' %}

{% block page_title %}Stempeluhr{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Worktime/_wt_styles.html.twig' %}
{% endblock %}

{% block page_content_start %}{% include '@Worktime/_flash.html.twig' %}{% endblock %}

{% block main %}
    {% set is_in = open_block is not null %}
    {% set review_count = today_blocks|filter(b => b.needsReview)|length %}
    <div class="wt wt--narrow"
         data-server-now="{{ server_now }}"
         data-today-base="{{ today_seconds }}"
         data-open-since="{{ is_in ? open_block.start.getTimestamp() : '' }}">

        <div class="wt-eyebrow">
            <strong>{{ today|day_name }}, {{ today|date_short }}</strong>
        </div>

        <section class="wt-hero {{ is_in ? 'wt-hero--in' : 'wt-hero--out' }}" aria-live="polite">
            {% if is_in %}
                <span class="wt-hero__pill"><span class="wt-dot" aria-hidden="true"></span> Läuft</span>
                <div class="wt-hero__clock" data-session-timer role="timer" aria-label="Laufende Sitzung">0:00:00</div>
                <div class="wt-hero__sub">seit <strong>{{ open_block.start|time }}</strong> Uhr</div>
                <form method="post" action="{{ path('worktime_punch') }}" data-wt-once>
                    <input type="hidden" name="_token" value="{{ csrf_token('worktime.punch') }}">
                    <input type="hidden" name="expect" value="out">
                    <button type="submit" class="wt-punch wt-punch--out">
                        <i class="{{ 'stop'|icon }}" aria-hidden="true"></i> Ausstempeln
                    </button>
                </form>
            {% else %}
                <span class="wt-hero__pill">Bereit</span>
                <div class="wt-hero__clock">Nicht eingestempelt</div>
                <div class="wt-hero__sub">Stempel dich ein, um deine Arbeitszeit zu erfassen.</div>
                <form method="post" action="{{ path('worktime_punch') }}" data-wt-once>
                    <input type="hidden" name="_token" value="{{ csrf_token('worktime.punch') }}">
                    <input type="hidden" name="expect" value="in">
                    <button type="submit" class="wt-punch wt-punch--in">
                        <i class="{{ 'start'|icon }}" aria-hidden="true"></i> Einstempeln
                    </button>
                </form>
            {% endif %}
        </section>

        <div class="wt-kpis" style="margin-top:1rem">
            <div class="wt-kpi wt-kpi--accent">
                <div class="wt-kpi__label">Heute gesamt</div>
                <div class="wt-kpi__value" data-today-total>{{ today_seconds|duration }}</div>
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Pause</div>
                <div class="wt-kpi__value">{{ today_break_seconds|duration }}</div>
            </div>
            <div class="wt-kpi">
                <div class="wt-kpi__label">Sitzungen</div>
                <div class="wt-kpi__value">{{ today_blocks|length }}</div>
            </div>
        </div>

        {% if review_count > 0 %}
            <div class="wt-note" role="status">
                <i class="fas fa-triangle-exclamation mt-1" aria-hidden="true"></i>
                <div>
                    <strong>{{ review_count == 1 ? 'Ein Eintrag wurde' : review_count ~ ' Einträge wurden' }} automatisch geschlossen – bitte Endzeit prüfen.</strong>
                    Du hattest vergessen auszustempeln. Öffne den markierten Eintrag und korrigiere die Endzeit.
                </div>
            </div>
        {% endif %}

        <div class="wt-sessions">
            <div class="wt-sessions__head">
                <h2 class="wt-sessions__title m-0">Heutige Stempelzeiten</h2>
                <button type="button" class="wt-add"
                        data-bs-toggle="modal" data-bs-target="#wtEntryModal"
                        data-mode="create" data-action="{{ path('worktime_entry_create') }}">
                    <i class="{{ 'create'|icon }}" aria-hidden="true"></i> Zeit eintragen
                </button>
            </div>
            {% for block in today_blocks %}
                <div class="wt-row {{ block.end is null ? 'wt-row--live' : (block.needsReview ? 'wt-row--review' : '') }}">
                    <span class="wt-row__bullet" aria-hidden="true"></span>
                    <span class="wt-row__time">
                        {{ block.start|time }}<span class="wt-arrow" aria-label="bis">→</span>{% if block.end is null %}<span class="wt-running">läuft</span>{% else %}{{ block.end|time }}{% endif %}
                        {% if block.needsReview %}<span class="wt-flag" title="Automatisch geschlossen – bitte Endzeit prüfen">bitte prüfen</span>{% endif %}
                    </span>
                    {% if block.end is null %}
                        <span class="wt-row__dur" data-live-since="{{ block.start.getTimestamp() }}">{{ (server_now - block.start.getTimestamp())|duration }}</span>
                    {% else %}
                        <span class="wt-row__dur">{{ block.durationSeconds|duration }}</span>
                    {% endif %}
                    <button type="button" class="wt-edit" aria-label="Eintrag {{ block.start|time }} bearbeiten" title="Bearbeiten"
                            data-bs-toggle="modal" data-bs-target="#wtEntryModal"
                            data-mode="edit"
                            data-action="{{ path('worktime_entry_edit', {id: block.id}) }}"
                            data-delete="{{ path('worktime_entry_delete', {id: block.id}) }}"
                            data-start="{{ block.start|date('Y-m-d\\TH:i', app.user.timezone) }}"
                            data-end="{{ block.end is null ? '' : block.end|date('Y-m-d\\TH:i', app.user.timezone) }}">
                        <i class="{{ 'edit'|icon }}" aria-hidden="true"></i>
                    </button>
                </div>
            {% else %}
                <div class="wt-empty">Noch keine Buchung heute.</div>
            {% endfor %}
        </div>

        {% include '@Worktime/_entry_modal.html.twig' with {token_id: 'worktime.entry'} %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var root = document.querySelector('.wt');
            if (!root) { return; }
            var since = parseInt(root.getAttribute('data-open-since'), 10);
            if (!since) { return; }
            var todayBase = parseInt(root.getAttribute('data-today-base'), 10) || 0;
            var serverNow = parseInt(root.getAttribute('data-server-now'), 10) || 0;
            // Uhrabweichung Client/Server ausgleichen, damit der Timer zu „seit HH:MM“ passt
            var offset = serverNow - Math.floor(Date.now() / 1000);
            var timerEl = root.querySelector('[data-session-timer]');
            var totalEl = root.querySelector('[data-today-total]');
            var liveEls = root.querySelectorAll('[data-live-since]');

            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            function hms(s) { s = Math.max(0, s); return Math.floor(s / 3600) + ':' + pad(Math.floor((s % 3600) / 60)) + ':' + pad(s % 60); }
            function hm(s) { s = Math.max(0, s); return Math.floor(s / 3600) + ':' + pad(Math.floor((s % 3600) / 60)); }

            function tick() {
                var now = Math.floor(Date.now() / 1000) + offset;
                if (timerEl) { timerEl.textContent = hms(now - since); }
                if (totalEl) { totalEl.textContent = hm(todayBase + (now - serverNow)); }
                liveEls.forEach(function (el) { el.textContent = hm(now - parseInt(el.getAttribute('data-live-since'), 10)); });
            }
            tick();
            setInterval(tick, 1000);
        })();
    </script>
{% endblock %}
